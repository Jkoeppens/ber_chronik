# Python
.venv/
__pycache__/
*.py[cod]
.python-version

# macOS
.DS_Store

# Data – raw bleibt lokal (Urheberrecht)
data/raw/

# Laufzeit-Daten (auf Railway im Volume, lokal nicht committen)
data/projects.db
data/projects.db-wal
data/projects.db-shm
data/neu.db
# Die WAL-Nebendateien gehören zur Datenbank und sind ohne sie wertlos. Sie
# fehlten hier und standen deshalb bei jedem Blick in git status als neu.
data/neu.db-wal
data/neu.db-shm
data/dropbox_tokens.json
*.npy

# Test- und Experiment-Projekte
data/projects/obsidian_*/
data/projects/zotero*/
data/projects/test_*/
data/projects/damaskus_test_*/
data/projects/*_test/
data/projects/*_test_*/
# Erzeugnisse einzelner Durchläufe und Messreihen des alten Systems. Sie
# entstehen beim Ausprobieren und sind aus der Quelle wiederherstellbar.
data/projects/baseline_*/
data/projects/rec_*/
data/projects/*_neu/
data/projects/*-probe/
data/projects/*-test-*/
data/projects/*-durchlauf/

# Exporte des neuen Systems: jederzeit aus data/neu.db neu erzeugbar
# (python3 -m src.neu.export.cli --projekt <kennung>)
#
# Der Inhalt, nicht das Verzeichnis: ein ausgeschlossenes Verzeichnis betritt
# git gar nicht erst, und die Ausnahme darunter käme nie zur Wirkung.
data/exporte/*

# Ausnahme: das Prüfstück. Ein eingefrorener ber-Export, gegen den die
# Playwright-Tests laufen — er ist gerade deshalb ein Prüfmaß, weil er NICHT
# neu erzeugt wird. Siehe data/exporte/pruefstueck/HERKUNFT.md.
!data/exporte/pruefstueck/

# Pipeline-Outputs die nicht versioniert werden
data/projects/*/obsidian_checkpoint.json
data/projects/*/zotero_checkpoint.json
data/projects/ber/documents/main/centroid_trajectory/

# Secrets
.env
.env.railway
invites.json

# Logs
logs/
node_modules

# Erzeugte Prüfberichte. playwright-report/ ist dreimal versehentlich
# mitgewandert und änderte sich danach bei jedem Testlauf — 37 KB Rauschen je
# Commit. Der Bericht entsteht aus playwright.config.js (reporter: html) und
# gehört dem Lauf, nicht dem Projekt.
playwright-report/
test-results/
